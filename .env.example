DJANGO_SECRET_KEY="your-real-secret-key"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://navaboard_app:your-real-database-password@127.0.0.1:5432/navaboard
# Use redis://127.0.0.1:6379/1 when running multiple application processes.
CACHE_URL=locmemcache://navaboard
DRF_NUM_PROXIES=0
OTP_REQUEST_IP_RATE=20/hour
OTP_REQUEST_PHONE_RATE=3/minute
OTP_VERIFY_IP_RATE=60/hour
OTP_VERIFY_PHONE_RATE=10/minute
EMAIL_CODE_REQUEST_IP_RATE=30/hour
EMAIL_CODE_REQUEST_EMAIL_RATE=3/minute
EMAIL_CODE_VERIFY_IP_RATE=60/hour
EMAIL_CODE_VERIFY_EMAIL_RATE=10/minute
EMAIL_LOGIN_IP_RATE=30/minute
EMAIL_LOGIN_EMAIL_RATE=5/minute
TOKEN_REFRESH_IP_RATE=120/hour
PASSWORD_MUTATION_USER_RATE=10/hour
OTP_DEVELOPMENT_CODE_IN_RESPONSE=True
EMAIL_VERIFICATION_DEVELOPMENT_CODE_IN_RESPONSE=True

SMS_PROVIDER=console
SMSIR_API_URL=https://api.sms.ir/v1/send/verify
SMSIR_API_KEY=replace-with-smsir-api-key
SMSIR_VERIFY_TEMPLATE_ID=0
SMSIR_CODE_PARAMETER_NAME=CODE
SMSIR_TIMEOUT_SECONDS=10

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email-username
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=NavaBoard <no-reply@example.com>

AUTH_REFRESH_COOKIE_NAME=navaboard_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_ENABLE_EMAIL_SIGNUP=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=
ATTACHMENT_MAX_BYTES=10485760
# Optional absolute private storage path; never expose it publicly.
# MEDIA_ROOT=/srv/navaboard/private-media
