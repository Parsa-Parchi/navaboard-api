DJANGO_SECRET_KEY="your-real-secret-key"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://navaboard_app:your-real-database-password@127.0.0.1:5432/navaboard
OTP_DEVELOPMENT_CODE_IN_RESPONSE=True
EMAIL_VERIFICATION_DEVELOPMENT_CODE_IN_RESPONSE=True

SMS_PROVIDER=console
SMSIR_API_URL=https://api.sms.ir/v1/send/verify
SMSIR_API_KEY=replace-with-smsir-api-key
SMSIR_VERIFY_TEMPLATE_ID=123456
SMSIR_CODE_PARAMETER_NAME=CODE
SMSIR_TIMEOUT_SECONDS=10

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email-username
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=NavaBoard <no-reply@example.com>